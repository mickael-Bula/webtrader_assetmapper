{% set currentStatus = id matches '/waiting/' ? 'waiting' : 'running' %}
{% set statusLabel = (currentStatus == 'waiting') ? 'en attente' : 'en cours' %}

<div class="offcanvas offcanvas-end bg-dark text-white" tabindex="-1" id="{{ id }}" style="width: 400px;">
    <div class="offcanvas-header border-bottom border-secondary">
        <h5 class="offcanvas-title" id="{{ id }}Label">Nouvelle Position {{ statusLabel }}</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body">
        {# On initialise le form avec l'option stimulus_controller #}
        {{ form_start(form, {
            'action': path('app_position_create'),
            'attr': { 'data-controller': 'position-calculator' }
        }) }}

        {# Champs cachés #}
        <input type="hidden" name="status" value="{{ currentStatus }}">
        <input type="hidden" data-position-calculator-target="positionSize" value="{{ app.user.positionSize }}">

        <div class="row mb-3">
            <div class="col-6">{{ form_row(form.buyPrice) }}</div>
            <div class="col-6">{{ form_row(form.lvcBuyPrice) }}</div>
        </div>

        <div class="row mb-4">
            <div class="col-6">{{ form_row(form.targetPrice) }}</div>
            <div class="col-6">{{ form_row(form.lvcTargetPrice) }}</div>
        </div>

        <hr class="text-secondary">

        <div class="mb-4">
            {{ form_row(form.quantity) }}
            <div class="form-text text-info opacity-75 small">Calculé automatiquement : Taille de la position / Prix LVC</div>
        </div>

        <hr class="text-secondary">

        <div class="mb-4">
            {{ form_row(form.createdAt) }}
            <div class="form-text text-info opacity-75 small">Par défaut : +3 mois</div>
        </div>

        <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" name="is_active" id="isActive">
            <label class="form-check-label text-white small" for="isActive">Rendre le point d'entrée Actif</label>
        </div>

        <div class="d-grid gap-2 mt-5">
            <button type="submit" class="btn btn-primary">Enregistrer la position</button>
        </div>
        {{ form_end(form) }}
    </div>
</div>
