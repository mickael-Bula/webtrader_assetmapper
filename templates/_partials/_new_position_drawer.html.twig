{# On récupère le type (running/waiting) via l'ID ou une variable passée à l'include #}
{% set currentStatus = id matches '/waiting/' ? 'waiting' : 'running' %}

<div class="offcanvas offcanvas-end bg-dark text-white" tabindex="-1" id="{{ id }}" aria-labelledby="{{ id }}Label" style="width: 400px;">
    <div class="offcanvas-header border-bottom border-secondary">
        <h5 class="offcanvas-title" id="{{ id }}Label">Nouvelle Position</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form action="{{ path('app_position_create') }}" method="POST">
            <input type="hidden" name="status" value="{{ currentStatus }}">
            <input type="hidden" id="position_size" value="{{ app.user.positionSize }}">

            <div class="row mb-3">
                <div class="col">
                    <label class="form-label text-white small">Achat CAC</label>
                    <input type="number" step="0.01" name="buy_price_cac" class="form-control bg-secondary text-white border-0" placeholder="7400">
                </div>
                <div class="col">
                    <label class="form-label text-white small">Achat LVC</label>
                    <input type="number" step="0.01" name="buy_price_lvc" id="buy_price_lvc" class="form-control bg-secondary text-white border-0" placeholder="12.50">
                </div>
            </div>

            <div class="row mb-4">
                <div class="col">
                    <label class="form-label text-white small">Cible revente CAC <span class="text-info opacity-75">(+10%)</span></label>
                    <input
                        type="number"
                        step="0.01"
                        name="target_price_cac"
                        id="target_price_cac"
                        class="form-control bg-secondary text-white border-0"
                        placeholder="7600"
                    >
                </div>
                <div class="col">
                    <label class="form-label text-white small">Cible revente LVC <span class="text-info opacity-75">(+20%)</span></label>
                    <input
                        type="number"
                        step="0.01"
                        name="target_price_lvc"
                        id="target_price_lvc"
                        class="form-control bg-secondary text-white border-0"
                        placeholder="14.20"
                    >
                </div>
            </div>

            <hr class="text-secondary">

            <div class="mb-4">
                <label class="form-label text-white small uppercase">Quantité</label>
                <input
                    type="number"
                    name="quantity"
                    id="quantity"
                    class="form-control bg-secondary text-white border-0"
                    placeholder="Ex: 10"
                    required
                >
                <div class="form-text text-info opacity-75 small">Calculé automatiquement : PositionSize / Prix LVC</div>
            </div>

            <hr class="text-secondary">

            <div class="mb-4">
                <label class="form-label text-white small uppercase">Date de validité</label>
                <input type="date" name="validity_date" id="new_pos_date" class="form-control bg-secondary text-white border-0">
                <div class="form-text text-info opacity-75 small">Par défaut : +3 mois</div>
            </div>

            <div class="d-grid gap-2 mt-5">
                <button type="submit" class="btn btn-primary">Enregistrer la position</button>
            </div>
        </form>
    </div>
</div>

<script>
    /**
     * Le script calcule automatiquement la quantité en fonction du prix LVC et de la taille de la position.
     * Une date de validité par défaut est également calculée à trois mois à partir de la date actuelle.
     */
    document.addEventListener('DOMContentLoaded', function() {
        // Éléments pour le calcul de quantité et cibles
        const positionSizeInput = document.getElementById('position_size');
        const buyPriceLvcInput = document.getElementById('buy_price_lvc');
        const buyPriceCacInput = document.querySelector('input[name="buy_price_cac"]'); // Ciblage par name s'il n'y a pas d'ID

        const quantityInput = document.getElementById('quantity');
        const targetPriceCacInput = document.getElementById('target_price_cac');
        const targetPriceLvcInput = document.getElementById('target_price_lvc');

        // 1. Calcul Quantité + Cible LVC (Déclenché par le prix LVC)
        if (buyPriceLvcInput) {
            buyPriceLvcInput.addEventListener('input', function() {
                const buyPriceLvc = parseFloat(this.value);

                // Calcul Quantité (Arrondi à l'inférieur pour ne pas dépasser le capital)
                const positionSize = parseFloat(positionSizeInput?.value || 0);
                if (positionSize > 0 && buyPriceLvc > 0) {
                    quantityInput.value = Math.floor(positionSize / buyPriceLvc);
                }

                // Calcul Cible LVC (+20% avec 2 décimales)
                if (buyPriceLvc > 0 && targetPriceLvcInput) {
                    targetPriceLvcInput.value = (buyPriceLvc * 1.20).toFixed(2);
                }
            });
        }

        // 2. Calcul de la cible de revente du CAC, déclenché par le prix CAC (Cible +10% arrondie à l'entier)
        if (buyPriceCacInput) {
            buyPriceCacInput.addEventListener('input', function() {
                const buyPriceCac = parseFloat(this.value);
                if (buyPriceCac > 0 && targetPriceCacInput) {
                    targetPriceCacInput.value = Math.round(buyPriceCac * 1.10);
                }
            });
        }

        // 3. Date de validité par défaut (+3 mois)
        const dateInput = document.getElementById('new_pos_date');
        if (dateInput && !dateInput.value) {
            const date = new Date();
            date.setMonth(date.getMonth() + 3);
            dateInput.value = date.toISOString().split('T')[0];
        }
    });
</script>
