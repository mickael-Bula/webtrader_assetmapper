{# On récupère le type (running/waiting) via l'ID ou une variable passée à l'include #}
{% set currentStatus = id matches '/waiting/' ? 'waiting' : 'running' %}
{% set statusLabel = (currentStatus == 'waiting') ? 'en attente' : 'en cours' %}

<div
    class="offcanvas offcanvas-end bg-dark text-white"
    data-controller="position-calculator"
    tabindex="-1" id="{{ id }}"
    aria-labelledby="{{ id }}Label"
    style="width: 400px;">
    <div class="offcanvas-header border-bottom border-secondary">
        <h5 class="offcanvas-title" id="{{ id }}Label">Nouvelle Position {{ statusLabel }}</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <form action="{{ path('app_position_create') }}" method="POST">
            {# Inputs cachés pour le backend #}
            <input type="hidden" name="status" value="{{ currentStatus }}">

            {# Data pour Stimulus (plus besoin d'id ici) #}
            <input type="hidden" data-position-calculator-target="positionSize" value="{{ app.user.positionSize }}">

            <div class="row mb-3">
                <div class="col">
                    <label class="form-label text-white small">Achat CAC</label>
                    <input
                        type="number" step="0.01"
                        name="buy_price_cac"
                        data-position-calculator-target="buyCac"
                        data-action="input->position-calculator#calculate"
                        class="form-control bg-secondary text-white border-0"
                        placeholder="7400">
                </div>
                <div class="col">
                    <label class="form-label text-white small">Achat LVC</label>
                    <input
                        type="number"
                        step="0.01"
                        name="buy_price_lvc"
                        data-position-calculator-target="buyLvc"
                        data-action="input->position-calculator#calculate"
                        class="form-control bg-secondary text-white border-0"
                        placeholder="12.50">
                </div>
            </div>

            <div class="row mb-4">
                <div class="col">
                    <label class="form-label text-white small">Cible revente CAC <span class="text-info opacity-75">(+10%)</span></label>
                    <input
                        type="number"
                        step="0.01"
                        name="target_price_cac"
                        data-position-calculator-target="targetCac"
                        class="form-control bg-secondary text-white border-0"
                        placeholder="7600"
                    >
                </div>
                <div class="col">
                    <label class="form-label text-white small">Cible revente LVC <span class="text-info opacity-75">(+20%)</span></label>
                    <input
                        type="number"
                        step="0.01"
                        name="target_price_lvc"
                        data-position-calculator-target="targetLvc"
                        class="form-control bg-secondary text-white border-0"
                        placeholder="14.20"
                    >
                </div>
            </div>

            <hr class="text-secondary">

            <div class="mb-4">
                <label class="form-label text-white small uppercase">Quantité</label>
                <input
                    type="number"
                    name="quantity"
                    data-position-calculator-target="quantity"
                    class="form-control bg-secondary text-white border-0"
                    placeholder="Ex: 10"
                    required
                >
                <div class="form-text text-info opacity-75 small">Calculé automatiquement : Taille de la position / Prix LVC</div>
            </div>

            <hr class="text-secondary">

            <div class="mb-4">
                <label class="form-label text-white small uppercase">Date de validité</label>
                <input type="date"
                       name="validity_date"
                       data-position-calculator-target="validityDate"
                       class="form-control bg-secondary text-white border-0">
                <div class="form-text text-info opacity-75 small">Par défaut : +3 mois</div>
            </div>

            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" name="is_active" id="isActive">
                <label class="form-check-label text-white small" for="isActive">Rendre le point d'entrée Actif</label>
            </div>

            <div class="d-grid gap-2 mt-5">
                <button type="submit" class="btn btn-primary">Enregistrer la position</button>
            </div>
        </form>
    </div>
</div>
