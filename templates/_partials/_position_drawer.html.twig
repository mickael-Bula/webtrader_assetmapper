{% set currentCacPrice = app.user.lastCacUpdated.close ?? 0 %}

{# On ne calcule la distance que si la position existe ET qu'on a un cours. Distance contient [points, percent, is_close] #}
{% set distance = (position is defined and currentCacPrice > 0) ? position.targetDistance(currentCacPrice) : null %}

<div class="offcanvas offcanvas-end bg-dark text-white" tabindex="-1" id="offcanvasPosition{{ position.id }}"
     style="width: 400px;">
    <div class="offcanvas-header border-bottom border-secondary">
        <h5 class="offcanvas-title">Position #{{ position.id }} - Rang {{ position.rank }}</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
    </div>

    <div class="offcanvas-body">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <span class="badge {{ position.status.value == 'waiting' ? 'bg-warning text-dark' : 'bg-success' }}">
                {{ position.status.value|upper }}
            </span>
            <small class="text-secondary italic">Créé le {{ position.createdAt|date('d/m/y à H:i') }}</small>
        </div>

        <div class="card bg-black border-secondary mb-4 shadow-sm">
            <div class="card-body text-center">
                {% if distance is not null %}
                    <small class="text-secondary d-block mb-1">DISTANCE DE L'OBJECTIF</small>
                    <h2 class="{{ distance.points > 0 ? 'text-info' : 'text-success' }} mb-0">
                        {{ distance.points > 0 ? '+' : '' }}{{ distance.points }} pts
                    </h2>
                    <div class="badge {{ distance.is_close ? 'bg-danger animate-pulse' : 'bg-secondary' }} mt-2">
                        {{ distance.percent }} %
                    </div>
                {% else %}
                    {# Affichage de remplacement si le cours est manquant #}
                    <div class="py-3">
                        <i class="mdi mdi-database-off text-secondary d-block h4"></i>
                        <span class="small text-muted italic">Données boursières indisponibles</span>
                    </div>
                {% endif %}
            </div>
        </div>

        <div class="row g-3">
            <div class="col-6">
                <label class="small text-secondary">Achat (CAC)</label>
                <div class="h5 border-start border-info ps-2">{{ position.buyPrice|number_format(2) }}</div>
            </div>
            <div class="col-6">
                <label class="small text-secondary">Objectif (CAC)</label>
                <div class="h5 border-start border-success ps-2">{{ position.targetPrice|number_format(2) }}</div>
            </div>

            <div class="col-12 mt-4">
                <h6 class="text-info border-bottom border-secondary pb-2">PRODUIT LVC (Levier x2)</h6>
                <div class="d-flex justify-content-between mt-2">
                    <span>Prix Achat LVC :</span>
                    <span class="fw-bold">{{ position.lvcBuyPrice }} €</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Objectif LVC :</span>
                    <span class="fw-bold text-success">{{ position.lvcTargetPrice }} €</span>
                </div>
                <div class="d-flex justify-content-between mt-2 pt-2 border-top border-secondary">
                    <span>Quantité :</span>
                    <span class="fw-bold">{{ position.getQuantity() }} titres</span>
                </div>
            </div>
        </div>
    </div>

    <div class="offcanvas-footer p-3 border-top border-secondary d-flex gap-2">
        <a href="#" class="btn btn-primary w-100">Modifier</a>
        <button class="btn btn-outline-danger w-100">Supprimer</button>
    </div>
</div>
