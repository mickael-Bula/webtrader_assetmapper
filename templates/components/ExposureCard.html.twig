<div class="exposure-wrapper d-flex align-items-center justify-content-center mx-2">
    <div style="position: relative; width: 60px; height: 60px;">
        {{ render_chart(chart) }}

        <div style="
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            text-align: center;
            pointer-events: none;
        ">
            <span class="d-block fw-bold text-white" style="font-size: 0.8rem; line-height: 1;">
                {{ percentage }}%
            </span>
        </div>
    </div>
</div>
