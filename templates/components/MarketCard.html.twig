<div class="col-card">

    {# 1. Ajoute "position-relative" ici pour servir d'ancre au bouton #}
    <div class="card card-small position-relative" {{ attributes }}> {# L'ajout de {{ attributes }} permet de propager les data-attributes #}

        {# 2. Bouton positionné en absolu #}
        {% if canCalculate %}
            <button type="button"
                    class="btn-calc-compact rounded-circle position-absolute"
                    style="top: 8px; right: 8px;"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#calculatorOffcanvas"
                    data-action="click->calculator#prepare"
                    data-value="{{ value }}"
                    data-mode="{{ title == 'UPPER RANGE' ? 'next-cycle' : 'normal' }}"
                    title="Calculer">
                <i class="mdi mdi-calculator" style="font-size: 14px;"></i>
            </button>
        {% endif %}

        <div class="card-title">
            {{ title }}
        </div>
        <div class="card-text card-metrics">
            <span class="h6 fw-bold text-white">{{ this.formattedValue }}</span>
            {% if trend == 'up' %}
                <i class="mdi mdi-arrow-up-thin icon-up add-margin-left"></i>
                <span class="small text-webtrader-muted">{{ subtitle }}</span>
            {% elseif trend == 'down' %}
                <i class="mdi mdi-arrow-down-thin icon-down add-margin-left"></i>
                <span class="small text-webtrader-muted">{{ subtitle }}</span>
            {% else %}
                <span class="small add-margin-left text-webtrader-muted">{{ subtitle }}</span>
            {% endif %}
        </div>
    </div>
</div>
