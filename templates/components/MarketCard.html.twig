<div class="col-card">
    <div class="card card-small">
        <div class="card-title">{{ title }}</div>
        <div class="card-text card-metrics">
            <span class="h6 fw-bold text-white">{{ this.formattedValue }}</span>
            {% if trend == 'up' %}
                <i class="mdi mdi-arrow-up-thin icon-up add-margin-left"></i>
                <span class="small text-webtrader-muted">{{ subtitle }}</span>
            {% elseif trend == 'down' %}
                <i class="mdi mdi-arrow-down-thin icon-down add-margin-left"></i>
                <span class="small text-webtrader-muted">{{ subtitle }}</span>
            {% else %}
                <span class="small add-margin-left text-webtrader-muted">{{ subtitle }}</span>
            {% endif %}
        </div>
    </div>
</div>
