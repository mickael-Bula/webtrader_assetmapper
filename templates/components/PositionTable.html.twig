<div class="card position-card {{ type }}-positions">
    <div class="card-title {{ this.headerClass }}">
        {{ this.displayTitle }}
    </div>
    <div class="card-divider"></div>
    <div class="card-text pa-0">
        <table class="table table-dark table-hover position-table mb-0">
            <thead>
            <tr class="text-secondary small">
                <th rowspan="2">{{ this.dateLabel }}</th>
                <th rowspan="2">Qté</th>
                <th rowspan="2">Trade</th>
                <th colspan="2" class="align-center">Achat</th>
                <th colspan="2" class="align-left">Revente</th>
                <th rowspan="2" class="align-left">Détail</th>
            </tr>
            <tr>
                <th>LVC</th>
                <th>CAC</th>
                <th>LVC</th>
                <th>CAC</th>
            </tr>
            </thead>
            <tbody class="text-white">
            {% for pos in positions %}
                <tr>
                    {# Si la date de validité d'une position en attente est proche, elle est signalée #}
                    <td class="{{ this.isExpiringSoon(pos) ? 'text-warning fw-bold' : '' }}">
                        {{ this.formattedDate(pos) }}
                        {% if this.isExpiringSoon(pos) %}
                            <i class="mdi mdi-clock-alert" title="Expire bientôt"></i>
                        {% endif %}
                    </td>
                    <td>{{ pos.quantity }}</td>
                    <td>{{ pos.id }}</td>
                    <td class="text-nowrap">{{ pos.lvcBuyPrice|number_format(2, ',', ' ') }}</td>
                    <td class="text-nowrap">{{ pos.buyPrice|number_format(0, ',', ' ') }}</td>
                    <td class="text-nowrap">{{ pos.lvcTargetPrice|number_format(2, ',', ' ') }}</td>
                    <td class="text-nowrap">{{ pos.targetPrice|number_format(0, ',', ' ') }}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-info"
                                type="button"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#offcanvasPosition{{ pos.id }}">
                            <i class="mdi mdi-eye"></i>
                        </button>

                        {# On inclut le menu latéral ici pour qu'il ait accès à la variable 'pos' #}
                        {{ include('_partials/_position_drawer.html.twig', { 'position': pos }) }}
                    </td>

                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ type == 'running' ? 8 : 7 }}" class="text-center">Aucune position</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
