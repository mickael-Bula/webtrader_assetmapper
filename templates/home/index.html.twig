{% extends 'base.html.twig' %}

{% block body %}
    <div class="dashboard-container"
         data-controller="calculator"
         data-calculator-last-cac-value="{{ lastQuote }}"
         data-calculator-last-lvc-value="{{ lastLvcQuote|default(0) }}">
        <div class="notification-area">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    {% set bootstrapClass = (label == 'error') ? 'danger' : (label == 'success' ? 'success' : 'info') %}

                    <div class="alert alert-{{ bootstrapClass }} alert-dismissible fade show"
                         role="alert"
                         data-controller="alert">
                        <div class="d-flex align-items-center">
                            {% if label == 'error' %}
                                <i class="mdi mdi-alert-circle me-2"></i>
                            {% elseif label == 'success' %}
                                <i class="mdi mdi-check-circle me-2"></i>
                            {% else %}
                                <i class="mdi mdi-information me-2"></i>
                            {% endif %}

                            <div>{{ message }}</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <div class="main-content-row d-flex">

            <div class="col-left">

                <div class="row-header d-flex align-start">
                    <twig:MarketCard
                        title="UPPER RANGE"
                        :value="upperRange"
                        :subtitle="entrypointCreatedAt"
                        :canCalculate="true"
                        data-calculator-target="trigger"
                        data-action="click->calculator#prepare"
                        data-value="{{ upperRange }}"
                        data-mode="next-cycle"
                    />
                    <twig:MarketCard
                        title="CAC"
                        :value="lastQuote"
                        :subtitle="cacSubtitle"
                        :trend="cacTrend"
                    />
                    <twig:MarketCard
                        title="BUY LIMIT"
                        :value="buyLimit"
                        :subtitle="buyLimitSubtitle"
                        :trend="buyLimitTrend"
                        :canCalculate="true"
                        data-calculator-target="trigger"
                        data-action="click->calculator#prepare"
                        data-value="{{ buyLimit }}"
                        data-mode="normal"
                    />
                </div>

                <div class="row-table">
                    <div class="col-table">
                        <div class="row-table">
                            <div class="col-table">
                                <twig:StockMarketTable :quotes="cacQuotes"/>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-right">

                <div class="image-box elevation-5" data-controller="chart">
                    <div class="tabs-container d-flex mb-2">
                        <button class="tab-btn"
                                data-action="click->chart#switch"
                                data-url="{{ chart_url('/charts/fchi_hourly.png') }}">Horaire
                        </button>
                        <button class="tab-btn active"
                                data-action="click->chart#switch"
                                data-url="{{ chart_url('/charts/fchi_daily.png') }}">Quotidien
                        </button>
                        <button class="tab-btn"
                                data-action="click->chart#switch"
                                data-url="{{ chart_url('/charts/fchi_weekly.png') }}">Hebdo
                        </button>
                    </div>

                    <div class="chart-display">
                        <img data-chart-target="display"
                             src="{{ chart_url('/charts/fchi_daily.png') }}"
                             alt="Graphique CAC40"
                             class="full-width-image"/>
                    </div>
                </div>

                <div class="row-positions-spacer d-flex">
                    <div class="col-positions-wrap">
                        <div class="col-positions">
                            <twig:PositionTable
                                type="running"
                                :positions="runningPositions"
                            />
                            <twig:PositionTable
                                type="waiting"
                                :positions="waitingPositions"
                            />
                        </div>
                    </div>
                    <div class="col-spacer"></div>
                </div>

            </div>
        </div>

        {# TODO : faire de ce bout de code un partial ? #}
        {# Offcanvas du calculateur #}
        <div class="offcanvas offcanvas-end bg-dark text-white"
             tabindex="-1"
             id="calculatorOffcanvas"
             style="width: 450px;">

            <div class="offcanvas-header border-bottom border-secondary">
                <h5 class="offcanvas-title" data-calculator-target="title">Calculateur de cycle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>

            <div class="offcanvas-body">
                {# Réutilisation du formulaire de calculateur #}
                <div class="mb-4 p-3 bg-black bg-opacity-50 rounded-4 border border-secondary border-opacity-25">
                    <div class="mb-3">
                        <label class="form-label small text-uppercase fw-bold text-secondary" data-calculator-target="inputLabel">
                            Seuil d'entrée
                        </label>
                        <input type="number"
                               data-calculator-target="entrypoint"
                               data-action="input->calculator#calculate"
                               value="{{ lastQuote|round }}"
                               class="form-control bg-dark text-white border-secondary">
                    </div>
                    <div>
                        <label class="form-label small text-uppercase fw-bold text-secondary">Spread</label>
                        <select data-calculator-target="spread"
                                data-action="change->calculator#calculate"
                                class="form-select bg-dark text-white border-secondary">
                            <option value="0.01">1%</option>
                            <option value="0.02" selected>2%</option>
                            <option value="0.03">3%</option>
                        </select>
                    </div>
                </div>

                <table class="table table-dark table-hover mb-0">
                    <thead>
                    <tr class="text-muted small">
                        <th class="ps-3">RANG</th><th>STATUT</th><th>ACHAT</th><th>REVENTE</th>
                    </tr>
                    </thead>
                    <tbody data-calculator-target="simulationBody"></tbody>
                </table>

                <div class="mt-4 p-3 border-top border-secondary">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="small text-secondary">Prochain cycle <small data-calculator-target="cycleLabel"></small> :</span>
                        <span data-calculator-target="nextCycle" class="badge bg-warning text-dark fs-6 fw-bold">--</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}
