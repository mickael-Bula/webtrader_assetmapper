{% extends 'base.html.twig' %}

{% block body %}
    <div class="dashboard-container"
         data-controller="calculator editor" {# Liaison à deux controllers Stimulus #}
         data-calculator-journal-outlet="#position-journal" {# Déclare la dépendance entre calculator et journal #}
         data-editor-user-spread-value="{{ userSpread }}"
         data-calculator-last-cac-value="{{ lastQuote }}"
         data-calculator-last-lvc-value="{{ lastLvcPrice }}"
         data-calculator-position-size-value="{{ positionSize }}">
        <div class="notification-area">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    {% set bootstrapClass = (label == 'error') ? 'danger' : (label == 'success' ? 'success' : 'info') %}

                    <div class="alert alert-{{ bootstrapClass }} alert-dismissible fade show"
                         role="alert"
                         data-controller="alert">
                        <div class="d-flex align-items-center">
                            {% if label == 'error' %}
                                <i class="mdi mdi-alert-circle me-2"></i>
                            {% elseif label == 'success' %}
                                <i class="mdi mdi-check-circle me-2"></i>
                            {% else %}
                                <i class="mdi mdi-information me-2"></i>
                            {% endif %}

                            <div>{{ message }}</div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <div class="main-content-row d-flex">

            <div class="col-left">

                <div class="row-header d-flex align-items-center">
                    <twig:MarketCard
                        title="UPPER RANGE"
                        :value="upperRange"
                        :subtitle="entrypointCreatedAt"
                        :canCalculate="true"
                        data-calculator-target="trigger"
                        data-action="click->calculator#prepare"
                        data-value="{{ upperRange }}"
                        data-mode="next-cycle"
                    />
                    <twig:MarketCard
                        title="CAC"
                        :value="lastQuote"
                        :subtitle="cacSubtitle"
                        :trend="cacTrend"
                    />
                    <twig:MarketCard
                        title="BUY LIMIT"
                        :value="buyLimit"
                        :subtitle="buyLimitSubtitle"
                        :trend="buyLimitTrend"
                        :canCalculate="true"
                        data-calculator-target="trigger"
                        data-action="click->calculator#prepare"
                        data-value="{{ buyLimit }}"
                        data-mode="normal"
                    />
                    {# Le composant indiquant le capital exposé #}
                    <twig:ExposureCard
                        :chart="exposureChart"
                        :percentage="exposurePercentage"
                        :used="exposureUsed"
                        :remaining="exposureRemaining"
                    />
                </div>

                <div class="row-table">
                    <div class="col-table">
                        <div class="row-table">
                            <div class="col-table">
                                <twig:StockMarketTable :quotes="cacQuotes"/>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <div class="col-right">

                <div class="image-box elevation-5" data-controller="chart">
                    <div class="tabs-container d-flex mb-2">
                        <button class="tab-btn"
                                data-action="click->chart#switch"
                                data-url="{{ chart_url('/charts/fchi_hourly.png') }}">Horaire
                        </button>
                        <button class="tab-btn active"
                                data-action="click->chart#switch"
                                data-url="{{ chart_url('/charts/fchi_daily.png') }}">Quotidien
                        </button>
                        <button class="tab-btn"
                                data-action="click->chart#switch"
                                data-url="{{ chart_url('/charts/fchi_weekly.png') }}">Hebdo
                        </button>
                    </div>

                    <div class="chart-display">
                        <img data-chart-target="display"
                             src="{{ chart_url('/charts/fchi_daily.png') }}"
                             alt="Graphique CAC40"
                             class="full-width-image"/>
                    </div>
                </div>

                {# CoreCard occupant la même largeur que le graphique #}
                <twig:CoreCard
                    :totalQuantity="55"
                    :targetValue="3750"
                    :currentValue="2400"
                    :pru="coreStats.pru"
                    :progressPercent="12"
                />

                <div class="row-positions-spacer d-flex">
                    <div class="col-positions-wrap">
                        <div class="col-positions">

                            {# POSITIONS EN COURS #}
                            <twig:PositionTable
                                type="running"
                                :positions="runningPositions"
                                :form="formRunning"
                            />

                            {# POSITIONS EN ATTENTE #}
                            <twig:PositionTable
                                type="waiting"
                                :positions="waitingPositions"
                                :form="formWaiting"
                            />

                            {# 3. JOURNAL DE SUIVI #}
                            <twig:PositionJournal />
                        </div>
                    </div>
                    <div class="col-spacer"></div>
                </div>

            </div>
        </div>

        {# Appel de l'offcanvas du calculateur #}
        <twig:Calculator lastQuote="{{ lastQuote }}" />

        {# Appel de l'offcanvas d'édition des cards #}
        <twig:EditorOffcanvas />

    </div>
{% endblock %}
