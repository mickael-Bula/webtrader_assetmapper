{% extends 'base.html.twig' %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4 text-white">Détail du portefeuille</h1>

        <div class="row g-3 mb-4">
            {# Carte Valeur Totale #}
            <div class="col-md-4">
                <div class="card bg-dark text-white border-secondary h-100">
                    <div class="card-body">
                        <h6 class="text-white opacity-75 text-uppercase small">Valeur Totale (Equity)</h6>
                        <h2 class="display-12 fw-bold">{{ stats.total_equity|number_format(2, ',', ' ') }} €</h2>
                        {% if perf.is_calculable %}
                            <div class="{% if perf.diff >= 0 %}text-success{% else %}text-danger{% endif %} fw-bold">
                                <i class="bi {{ perf.diff >= 0 ? 'bi-caret-up-fill' : 'bi-caret-down-fill' }}"></i>
                                {{ perf.diff >= 0 ? '+' : '' }}{{ perf.diff|number_format(2, ',', ' ') }} €
                                ({{ perf.percent|number_format(2, ',', ' ') }}%)
                                <span class="text-secondary fw-normal small">depuis la dernière cotation</span>
                            </div>
                        {% else %}
                            <div class="text-info opacity-75 small">
                                <i class="bi bi-info-circle me-1"></i>
                                Analyse de performance disponible à la prochaine clôture
                            </div>
                        {% endif %}
                        <div class="{% if daily_diff >= 0 %}text-success{% else %}text-danger{% endif %} fw-bold">
                            {{ daily_diff >= 0 ? '+' : '' }}{{ daily_diff|number_format(2, ',', ' ') }} €
                            ({{ daily_percent|number_format(2, ',', ' ') }}%) aujourd'hui
                        </div>
                    </div>
                </div>
            </div>

            {# Carte Exposition #}
            <div class="col-md-4">
                <div class="card bg-dark text-white border-secondary h-100">
                    <div class="card-body">
                        <h6 class="text-white opacity-75 text-uppercase small">Exposition</h6>
                        <h2 class="display-12 fw-bold">
                            {{ ((stats.total_equity - stats.cash_amount) / stats.total_equity * 100)|round(1)|number_format(2, ',', ' ') }} %
                        </h2>
                        <div class="mt-2">
                            <div class="progress" style="height: 6px; background: #222;">
                                <div
                                    class="progress-bar progress-bar-animated-fill"
                                    role="progressbar"
                                    style="
                                        width: {{ stats.exposure_percent|number_format(2, '.') }}%;
                                        background-color: {{ stats.exposure_color }} !important;"
                                ></div>
                            </div>

                            {# Label de la phase d'investissement #}
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="fw-bold text-white opacity-50" style="font-size: 0.75rem; letter-spacing: 0.8px;">
                                    {{ stats.exposure_label|upper }}
                                </span>
                            </div>

                            {# Description de la phase d'investissment #}
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-white opacity-50" style="font-size: 0.75rem; letter-spacing: 0.8px;">
                                    {{ stats.exposure_description }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Carte Cash #}
            <div class="col-md-4">
                <div class="card bg-dark text-white border-secondary h-100">
                    <div class="card-body">
                        <h6 class="text-white opacity-75 text-uppercase small">Cash disponible</h6>
                        <h2 class="display-12 fw-bold text-info">{{ stats.cash_amount|number_format(2, ',', ' ') }}
                            €</h2>
                        <span class="text-white opacity-50 small">Prêt pour de nouveaux signaux</span>
                    </div>
                </div>
            </div>
        </div>

        {# Détail des assets #}
        <div class="card bg-dark border-secondary mt-4">
            <div class="card-header border-secondary text-white fw-bold">
                Détail des actifs
            </div>
            <div class="table-responsive">
                <table class="table table-dark table-hover mb-0">
                    <thead>
                    <tr class="text-secondary small text-uppercase">
                        <th>Actif</th>
                        <th class="text-end">Quantité</th>
                        <th class="text-end">PRU</th>
                        <th class="text-end">Cours</th>
                        <th class="text-end">Valeur</th>
                        <th class="text-end">+/-values</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for asset in grouped_positions %}
                        <tr class="align-middle">
                            <td class="fw-bold text-info">{{ asset.name }}</td>
                            <td class="text-end text-info">{{ asset.total_quantity }}</td>
                            <td class="text-end text-info">{{ asset.pru|number_format(2, ',', ' ') }} €</td>
                            <td class="text-end text-info">{{ asset.current_price|number_format(2, ',', ' ') }} €</td>
                            <td class="text-end text-info fw-bold">{{ asset.total_current_value|number_format(2, ',', ' ') }}
                                €
                            </td>
                            <td class="text-end text-info">
                            <span class="badge {% if asset.pnl_euro >= 0 %}bg-success{% else %}bg-danger{% endif %}">
                                {{ asset.pnl_euro >= 0 ? '+' : '' }}{{ asset.pnl_euro|number_format(2, ',', ' ') }} €
                                ({{ asset.pnl_euro >= 0 ? '+' : '' }}{{ asset.pnl_percent|number_format(2, ',', '') }} %)
                            </span>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Aucune position ouverte actuellement.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# Zone Graphique #}
        <div class="card bg-dark border-secondary">
            <div class="card-header border-secondary d-flex justify-content-between align-items-center">
                <span class="text-white fw-bold">Évolution du capital (30 derniers jours)</span>
                <span class="badge bg-primary">Equity Curve</span>
            </div>
            <div class="card-body" style="height: 350px;">
                {% if history|length > 1 %}
                    {{ render_chart(chart) }}
                {% else %}
                    <div class="d-flex flex-column align-items-center justify-content-center h-100">
                        <i class="bi bi-graph-up text-secondary mb-2" style="font-size: 2rem;"></i>
                        <p class="text-info small">Données insuffisantes pour tracer la courbe (min. 2 jours).</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
