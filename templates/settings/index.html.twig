{% extends 'base.html.twig' %}

{% block title %}Configuration Stratégie - WebTrader{% endblock %}

{% block body %}
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">

                <div class="mb-4 text-center">
                    <h2 class="fw-bold text-white">Configuration du <span class="text-success">Portefeuille</span></h2>
                    <p class="text-webtrader-muted">Définissez vos règles de gestion pour activer la surveillance.</p>
                </div>

                <div class="card bg-dark text-white border-secondary shadow-lg">
                    <div class="card-body p-4">

                        {{ form_start(settingsForm, {'attr': {'data-turbo': 'false'}}) }}

                        <label class="form-label text-success fw-bold small uppercase">GESTION DU CAPITAL</label>
                        <div class="mb-4 p-3 bg-black rounded border border-secondary border-opacity-25">
                            <div class="mb-3">
                                {{ form_label(settingsForm.totalPortfolio, "Valeur totale du portefeuille") }}
                                <div class="input-group">
                                    {{ form_widget(settingsForm.totalPortfolio, {'attr': {
                                        'class': 'form-control bg-black text-white fs-5',
                                        'placeholder': '10000.00'
                                    }}) }}
                                    <span class="input-group-text bg-secondary text-white border-secondary">€</span>
                                </div>
                            </div>
                        </div>

                        <label class="form-label text-success fw-bold small uppercase">PARAMÈTRES DE LA POSITION INITIALE</label>
                        <div class="mb-4 p-3 bg-black rounded border border-secondary border-opacity-25">

                            <div class="mb-3">
                                {{ form_label(settingsForm.entrypoint, "Niveau d'achat souhaité (Seuil CAC40)") }}
                                {{ form_widget(settingsForm.entrypoint, {'attr': {
                                    'class': 'form-control bg-black text-white border-secondary',
                                    'placeholder': 'Ex: 7450.00',
                                    'step': '0.1'
                                }}) }}
                                <div class="form-text text-webtrader-muted small">L'achat du tracker sera exécuté quand le CAC40 atteindra ce niveau.</div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(settingsForm.spread, "Spread entre les positions (%)") }}
                                {{ form_widget(settingsForm.spread, {'attr': {
                                    'class': 'form-select bg-black text-white border-secondary'
                                }}) }}
                                <div class="form-text text-webtrader-muted small">Définit l'écart de prix entre vos 3 ordres d'achat.</div>
                            </div>

                            <div class="mb-2">
                                {{ form_label(settingsForm.positionSize, "Montant à allouer par position (€)") }}
                                <div class="input-group">
                                    {{ form_widget(settingsForm.positionSize, {'attr': {
                                        'class': 'form-control bg-black text-white fs-5',
                                        'placeholder': 'Ex: 1000.00'
                                    }}) }}
                                    <span class="input-group-text bg-secondary text-white">€</span>
                                </div>

                                {# Zone pour l'avertissement #}
                                <div id="risk-warning" class="mt-2 small text-warning d-none">
                                    <i class="mdi mdi-alert-outline"></i> Attention : Ce montant dépasse 10% de votre capital total.
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-2 small text-webtrader-muted">
                                <div>Ratio max (1/10e) : <strong id="ratio-val" class="text-success">-- €</strong></div>
                                <div>Ratio réel : <strong id="real-ratio-val" class="text-info">-- %</strong></div>
                            </div>

                        </div>

                        <div class="d-grid gap-2 pt-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold shadow-sm">
                                ACTIVER LA SURVEILLANCE
                            </button>
                        </div>

                        {{ form_end(settingsForm) }}
                    </div>
                </div>

                <div class="mt-4 text-center">
                    <a href="{{ path('app_strategy_description') }}" class="text-decoration-none text-webtrader-muted small">
                        <i class="mdi mdi-arrow-left"></i> Retour à la stratégie
                    </a>
                </div>

            </div>
        </div>
    </div>

    {# Déplacer le script dans assets/js #}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const portfolioInput = document.querySelector('[name*="entrypoint[totalPortfolio]"]');
            const positionSizeInput = document.querySelector('[name*="entrypoint[positionSize]"]');
            const ratioLabel = document.getElementById('ratio-val');
            const realRatioLabel = document.getElementById('real-ratio-val');
            const warning = document.getElementById('risk-warning');

            {# Sécurité : On s'assure que les éléments existent avant d'ajouter les listeners #}
            if (!portfolioInput || !positionSizeInput) {
                console.error('Éléments de formulaire non trouvés');
                return;
            }

            const checkRisk = () => {
                const total = parseFloat(portfolioInput.value);
                const size = parseFloat(positionSizeInput.value);

                if (!isNaN(total) && !isNaN(size) && total > 0) {
                    {# 1. Calcul Ratio Max (1/10e) #}
                    const tenPercent = (total / 10).toFixed(2);
                    ratioLabel.textContent = tenPercent + ' €';

                    {# 2. Calcul Ratio Réel en % #}
                    const realRatio = (size / total) * 100;
                    realRatioLabel.textContent = realRatio.toFixed(2) + ' %';

                    {# Gestion de la couleur si le risque est élevé (> 10%) #}
                    if (size > (total / 10)) {
                        warning.classList.remove('d-none');
                        realRatioLabel.classList.replace('text-info', 'text-danger');
                    } else {
                        warning.classList.add('d-none');
                        realRatioLabel.classList.replace('text-danger', 'text-info');
                    }
                } else {
                    ratioLabel.textContent = '-- €';
                    realRatioLabel.textContent = '-- %';
                }
            };

            portfolioInput.addEventListener('input', (e) => {
                const total = parseFloat(e.target.value);
                if (!isNaN(total) && total > 0) {
                    const tenPercent = (total / 10).toFixed(2);
                    ratioLabel.textContent = tenPercent + ' €';

                    checkRisk();
                }
            });

            {# On écoute aussi les changements manuels sur la taille de la position #}
            positionSizeInput.addEventListener('input', checkRisk);
        });
    </script>
{% endblock %}
