{% extends 'base.html.twig' %}

{% block title %}Description de la Stratégie - WebTrader{% endblock %}

{% block body %}
    <div class="bg-webtrader-dark text-light min-vh-100 pb-5">

        <header class="hero-gradient py-5 mb-5 border-bottom border-secondary border-opacity-25 relative">
            <div class="container py-4">
                <div class="row">
                    <div class="col-lg-8">
                        <div
                            class="d-inline-flex align-items-center justify-content-center p-3 bg-success bg-opacity-10 border border-green-web rounded-4 mb-4">
                            <svg class="text-success" width="32" height="32" fill="none" stroke="currentColor"
                                 viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                            </svg>
                        </div>
                        <h1 class="display-4 fw-bold text-white">
                            Description de la <span class="text-green-web">Stratégie</span>
                        </h1>
                        <p class="lead text-secondary mt-3">
                            Optimisation des entrées sur repli via le tracker LVC (levier x2) et une gestion rigoureuse
                            des plus hauts locaux.
                        </p>
                    </div>
                </div>
            </div>
        </header>

        <div class="container">
            <div class="row g-5">

                {# SECTION : CONFIGURATION INITIALE #}
                <div class="col-12">
                    <h3 class="h4 text-white mb-4 d-flex align-items-center">
                        <span class="mdi mdi-account-plus me-3 text-info"></span>
                        Opération lors d'une première connexion
                    </h3>

                    <div class="row g-3">
                        <div class="col-md-4">
                            <div
                                class="bg-webtrader-card p-3 rounded-4 h-100 border border-secondary border-opacity-10 shadow-sm">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="mdi mdi-elevation-rise text-info"></i>
                                    <h6 class="text-white mb-0">Plus haut local</h6>
                                </div>
                                <p class="small text-webtrader-muted mb-2">Sommet de référence du cycle.</p>
                                <div class="mt-auto">
                                    <span
                                        class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 small">
                                        Max : Cours CAC actuel
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div
                                class="bg-webtrader-card p-3 rounded-4 h-100 border border-secondary border-opacity-10 shadow-sm">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="mdi mdi-wallet text-primary"></i>
                                    <h6 class="text-white mb-0">Capital Alloué</h6>
                                </div>
                                <p class="small text-webtrader-muted mb-2">Montant total de la stratégie.</p>
                                <div class="mt-auto">
                                    <span
                                        class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 small">
                                        Conseil : 10x prix LVC
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div
                                class="bg-webtrader-card p-3 rounded-4 h-100 border border-secondary border-opacity-10 shadow-sm">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <i class="mdi mdi-chart-pie text-success"></i>
                                    <h6 class="text-white mb-0">Taille d'unité</h6>
                                </div>
                                <p class="small text-webtrader-muted mb-2">Montant par ligne d'achat.</p>
                                <div class="d-flex flex-wrap gap-2 mt-auto">
                                    <span
                                        class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 small">
                                        Min : Prix 1 LVC
                                    </span>
                                    <span
                                        class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 small">
                                        Max : 1/10e Capital
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# SECTION : DEFINITIONS #}
                <div class="col-md-6">
                    <div class="bg-webtrader-card p-4 rounded-4 h-100 shadow-lg">
                        <h4 class="h5 text-white mb-4 d-flex align-items-center">
                            <i class="mdi mdi-refresh me-2 text-primary"></i> Définition d'une position
                        </h4>
                        <div class="vstack gap-3">
                            <div class="d-flex align-items-center gap-3 p-2 rounded bg-dark bg-opacity-25">
                                <span class="badge bg-warning text-dark text-uppercase d-inline-block"
                                      style="width: 110px;">En attente</span>
                                <span class="small text-secondary">Seuil d'achat (BuyLimit) non touché.</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 p-2 rounded bg-dark bg-opacity-25">
                                <span class="badge bg-primary text-uppercase d-inline-block" style="width: 110px;">En cours</span>
                                <span class="small text-secondary">Achat actif, objectif de revente surveillé.</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 p-2 rounded bg-dark bg-opacity-25">
                                <span class="badge bg-success text-uppercase d-inline-block"
                                      style="width: 110px;">Vendu</span>
                                <span class="small text-secondary">Objectif de revente atteint (Trade clos).</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="bg-webtrader-card p-4 rounded-4 h-100 shadow-lg">
                        <h4 class="h5 text-white mb-4 d-flex align-items-center">
                            <i class="mdi mdi-layers me-2 text-warning"></i> Ligne vs Trade
                        </h4>
                        <div class="mb-3">
                            <label class="text-warning small fw-bold text-uppercase">La Ligne</label>
                            <p class="text-secondary small">Achat d'une ligne de LVC pour le montant configuré.</p>
                        </div>
                        <hr class="border-secondary border-opacity-25">
                        <div>
                            <label class="text-warning small fw-bold text-uppercase">Le Trade</label>
                            <p class="text-secondary small">Achat d'une ou plusieurs lignes liées à un plus haut. Clos à
                                la revente de la dernière ligne.</p>
                        </div>
                    </div>
                </div>

                {# NOUVELLE SECTION : RÈGLES DE GESTION DYNAMIQUE #}
                <div class="col-md-6">
                    <div class="bg-webtrader-card p-4 rounded-4 h-100 shadow-lg border-start border-3 border-info">
                        <h4 class="h5 text-white mb-4 d-flex align-items-center">
                            <i class="mdi mdi-arrow-up-bold-circle-outline me-2 text-info"></i> Ajustement du Seuil
                            (Trailing)
                        </h4>
                        <p class="text-secondary small">
                            Le système protège vos entrées en cas de hausse continue :
                        </p>
                        <div class="p-3 rounded bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <p class="small text-secondary mb-2">
                                Si le <strong>Plus Haut du CAC</strong> dépasse l'ancienne borne haute (Upper Range),
                                celle-ci est remontée au niveau du nouveau sommet.
                            </p>
                            <p class="small text-info mb-0 italic">
                                <i class="mdi mdi-information-outline me-1"></i>
                                Le Seuil d'Achat (Entrypoint) est alors automatiquement décalé pour maintenir l'écart de
                                6%.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="bg-webtrader-card p-4 rounded-4 h-100 shadow-lg border-start border-3 border-danger">
                        <h4 class="h5 text-white mb-4 d-flex align-items-center">
                            <i class="mdi mdi-shield-sync me-2 text-danger"></i> Purge & Nouveaux Cycles
                        </h4>
                        <p class="text-secondary small">
                            Lorsqu'une première ligne passe à l'état <span
                                class="badge bg-primary x-small">En cours</span> :
                        </p>
                        <div class="p-3 rounded bg-dark bg-opacity-50 border border-secondary border-opacity-25">
                            <p class="small text-secondary mb-0">
                                Un nouveau cycle de trois lignes est généré. Pour éviter les doublons sur des niveaux de
                                prix similaires :
                            </p>
                            <div class="mt-2 text-danger small fw-bold">
                                <i class="mdi mdi-delete-sweep me-1"></i> Toutes les anciennes positions "En attente"
                                sont supprimées.
                            </div>
                        </div>
                    </div>
                </div>

                {# SECTION : MONEY MANAGEMENT #}
                <div class="col-12 mt-5">
                    <div class="d-flex align-items-center mb-4">
                        <h3 class="h4 text-white mb-0">
                            <i class="mdi mdi-chart-donut me-2 text-info"></i> Répartition du Money Management
                        </h3>
                        <hr class="flex-grow-1 ms-3 border-secondary">
                    </div>

                    <p class="text-white mb-4">
                        Le <strong>Money Management</strong> se déroule en quatre phases successives.
                    </p>

                    <div class="row g-4">
                        {% set phases = [
                            {
                                'title': 'Investissement ',
                                'description': 'Investir 25 % du portefeuille sur repli en suivant la stratégie décrite. Les lignes sont conservées sans limite de temps.',
                                'color': '#0dcaf0', 'val': 25
                            },
                            {
                                'title': 'Accumulation',
                                'description': 'Achat identique à la phase 1, cible de revente à +10 % CAC (+20 % LVC). On revend uniquement le capital, les plus-values restent investies.',
                                'color': '#198754', 'val': 25
                            },
                            {
                                'title': 'Récupération',
                                'description': 'Modèle d\'investissement précédent, mais à la revente c\'est toute la ligne qui est soldée, plus-values comprises.',
                                'color': '#ffc107', 'val': 25
                            },
                            {
                                'title': 'Allègement',
                                'description': 'Procédure d\'achat identique, mais revente agressive : dès que la cible est atteinte, on vend pour ramener l\'investissement sous 75 % ou on solde toute la ligne.',
                                'color': '#dc3545', 'val': 25
                            }
                        ] %}

                        {# 1. La Ligne des Graphiques #}
                        <div class="row g-4 mb-5">
                            {% for phase in phases %}
                                <div class="col-md-3 col-sm-6">
                                    <div class="bg-webtrader-card p-3 rounded-4 h-100 border border-secondary border-opacity-10 text-center">
                                        <div style="height: 120px; position: relative;">
                                            <canvas
                                                data-controller="doughnut"
                                                data-doughnut-color-value="{{ phase.color }}"
                                                data-doughnut-percentage-value="{{ phase.val }}"
                                                data-doughnut-rotation-value="{{ loop.index0 * 90 }}">
                                            </canvas>
                                        </div>
                                        <h6 class="text-white mt-3 mb-0">{{ phase.title }}</h6>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>

                        {# 2. La Ligne des Descriptions (sous les cards) #}
                        <div class="row g-4">
                            {% for phase in phases %}
                                <div class="col-md-3 col-sm-6">
                                    <div class="card bg-dark border-secondary bg-opacity-25 h-100">
                                        <div class="card-body">
                                            <h6 class="text-info fw-bold mb-2">{{ phase.title }}</h6>
                                            <p class="small text-secondary m-0">
                                                {{ phase.description }}
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                {# SECTION : SIMULATEUR #}
                <div class="col-12">
                    <section
                        class="glass-effect rounded-4 p-4 p-md-5 border border-secondary border-opacity-25 shadow-sm"
                        data-controller="calculator"
                        data-calculator-last-cac-value="{{ lastCacPrice|default(0) }}"
                        data-calculator-last-lvc-value="{{ lastLvcPrice|default(0) }}">

                        <div class="row g-4">
                            {# COLONNE DE GAUCHE : CONTRÔLES #}
                            <div class="col-lg-6">
                                <div class="d-flex align-items-start gap-3 mb-4">
                                    <div class="p-2 bg-success bg-opacity-10 rounded-3">
                                        <i class="mdi mdi-calculator fs-3 text-green-web"></i>
                                    </div>
                                    <div>
                                        <h2 class="h3 text-white mb-1">Simulateur de Cycle</h2>
                                        <p class="text-webtrader-muted small">
                                            Saisissez un seuil d'entrée et un spread pour visualiser l'étagement de vos positions
                                        </p>
                                    </div>
                                </div>

                                <div
                                    class="p-4 bg-black bg-opacity-50 rounded-4 border border-secondary border-opacity-25">
                                    <div class="mb-3">
                                        <label class="form-label text-webtrader-muted small text-uppercase fw-bold">Seuil
                                            d'entrée</label>
                                        <input type="number"
                                               data-calculator-target="entrypoint"
                                               data-action="input->calculator#calculate"
                                               value="{{ lastCacPrice|default(0)|round }}"
                                               class="form-control form-control-lg bg-dark text-white border-secondary">
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label text-webtrader-muted small text-uppercase fw-bold">
                                            Spread par palier
                                        </label>
                                        <select data-calculator-target="spread"
                                                data-action="change->calculator#calculate"
                                                class="form-select bg-dark text-white border-secondary">
                                            <option value="0.01">1 %</option>
                                            <option value="0.02" selected>2 %</option>
                                            <option value="0.03">3 %</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            {# COLONNE DE DROITE : RÉSULTATS #}
                            <div class="col-lg-6">
                                <div class="card bg-black border-secondary h-100 shadow-lg">
                                    <div class="card-header border-secondary bg-dark bg-opacity-50 py-3">
                                        <span class="text-success small fw-bold text-uppercase italic">
                                            <i class="mdi mdi-layers-triple me-2"></i>Ordres du cycle
                                        </span>
                                    </div>
                                    <div class="card-body p-0">
                                        <div class="table-responsive">
                                            <table class="table table-dark table-hover mb-0">
                                                <thead>
                                                <tr class="text-muted small border-bottom border-secondary">
                                                    <th class="text-start ps-3" style="width: 15%;">RANG</th>
                                                    <th class="text-center" style="width: 25%;">STATUT</th>
                                                    <th class="text-center" style="width: 30%;">ACHAT</th>
                                                    <th class="text-end pe-3" style="width: 30%;">REVENTE</th>
                                                </tr>
                                                </thead>
                                                <tbody data-calculator-target="simulationBody" class="border-0"></tbody>
                                            </table>
                                        </div>
                                    </div>
                                    <div class="card-footer border-secondary bg-dark bg-opacity-25 p-3">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <span class="small text-secondary">
                                                Prochain cycle
                                                <small class="text-secondary" data-calculator-target="cycleLabel">( -- %)</small> :
                                            </span>
                                            <span data-calculator-target="nextCycle"
                                                  class="badge bg-warning text-dark fs-6 fw-bold">-- pts
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                {# SECTION : PERFORMANCE #}
                <div class="col-12">
                    <div class="p-4 p-md-5 rounded-4 border border-secondary border-opacity-25 shadow"
                         style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                        <h3 class="h4 text-white mb-4">Seuils Stratégiques par défaut & Performance</h3>
                        <div class="row g-4 text-center text-md-start">
                            <div class="col-md-4">
                                <div class="h2 fw-bold text-danger">-6% <span class="fs-6 text-secondary fw-normal">sur CAC</span>
                                </div>
                                <p class="small text-secondary mb-0">Baisse requise depuis le dernier plus haut pour
                                    ouvrir un cycle.</p>
                            </div>
                            <div class="col-md-4 border-start border-secondary border-opacity-25">
                                <div class="h2 fw-bold text-info">2% <span
                                        class="fs-6 text-secondary fw-normal">d'écart</span></div>
                                <p class="small text-secondary mb-0">Intervalle entre les trois lignes d'achat (Lissage
                                    du PRU).</p>
                            </div>
                            <div class="col-md-4 border-start border-secondary border-opacity-25">
                                <div class="d-flex align-items-baseline gap-2">
                                    <div class="h2 fw-bold text-success">+10%</div>
                                    <div
                                        class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25">
                                        Objectif LVC : +20%
                                    </div>
                                </div>
                                <p class="small text-secondary mb-0">Seuil de revente sur le CAC40 avec effet de levier
                                    x2 appliqué.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="border-start border-4 border-success ps-4 py-2 my-4">
                        <h4 class="h5 text-white italic">Plus haut local</h4>
                        <p class="text-secondary fst-italic mb-0">
                            "La cotation la plus élevée atteinte par le CAC depuis la dernière prise de position.
                            À défaut, fixé au plus haut de la dernière cotation disponible."
                        </p>
                    </div>
                </div>

                <div class="col-12 text-center py-4">
                    <a href="{{ path('app_settings') }}"
                       class="btn btn-success btn-lg px-5 py-3 rounded-pill fw-bold shadow-lg transform-hover">
                        <i class="mdi mdi-cog-outline me-2"></i> Configurer mon portefeuille
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
